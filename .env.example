# Optional. If set, the LLM-as-judge layer calls NVIDIA's hosted NIM API
# (https://build.nvidia.com) instead of falling back to the offline heuristic judge.
# NVIDIA_NIM_MODEL must be a currently-deployed model -- check with:
#   python -c "from openai import OpenAI; import os; print([m.id for m in OpenAI(base_url=os.environ['NVIDIA_NIM_BASE_URL'], api_key=os.environ['NVIDIA_API_KEY']).models.list().data])"
# (meta/llama-3.1-8b-instruct, an earlier default here, reached end-of-life
# on NVIDIA's catalog on 2026-08-26 and now returns HTTP 410.)
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
